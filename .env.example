# 应用配置 (开发环境)
# 复制此文件为 .env 并根据需要修改

APP_NAME=基于知识图谱的个性化荐书系统
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=bookrec
MYSQL_PASSWORD=bookrec123
MYSQL_DATABASE=book_recommender

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ElasticSearch
ES_HOST=http://localhost:9200

# 推荐系统参数
RECOMMEND_KG_WEIGHT=0.4
RECOMMEND_CF_WEIGHT=0.4
RECOMMEND_HOT_WEIGHT=0.1
RECOMMEND_NEW_WEIGHT=0.1
RECOMMEND_TOP_N=20

# 试读限制
TRIAL_PAGES_ANONYMOUS=3
TRIAL_PAGES_LOGGED_IN=10
