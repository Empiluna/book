PROJECT_NAME=基于知识图谱的个性化荐书系统
SECRET_KEY=change-me-in-production
# 默认使用 MySQL。可通过 docker compose up -d mysql 启动本地数据库。
DATABASE_URL=mysql+pymysql://root:root123456@localhost:3306/book_system?charset=utf8mb4
# 如需临时本地演示，可手动切回 SQLite：
# DATABASE_URL=sqlite:///./book_system.db
SEED_ON_STARTUP=true
CORS_ORIGINS=*

# Neo4j：知识图谱真实存储与Cypher多跳推理。
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
REQUIRE_NEO4J=false

# Redis：ItemCF相似度矩阵、热门推荐和系统配置缓存。
REDIS_URL=redis://localhost:6379/0

# ElasticSearch：中文全文检索，多字段搜索。
ELASTICSEARCH_URL=http://localhost:9200
SEARCH_INDEX_NAME=books
REQUIRE_ELASTICSEARCH=false

# OpenAI兼容LLM：智能问答意图识别、上下文增强回答、自然语言荐书。
OPENAI_COMPATIBLE_API_BASE=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=20
REQUIRE_LLM=false

# 推荐与试读配置。
RECOMMEND_KG_WEIGHT=0.40
RECOMMEND_CF_WEIGHT=0.40
RECOMMEND_HOT_WEIGHT=0.10
RECOMMEND_NEW_WEIGHT=0.10
ITEMCF_CACHE_TTL_SECONDS=21600
TRIAL_PAGES_ANONYMOUS=3
TRIAL_PAGES_LOGIN=10
MAX_SHELVES_PER_USER=20
