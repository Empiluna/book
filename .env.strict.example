PROJECT_NAME=基于知识图谱的个性化荐书系统
SECRET_KEY=change-me-in-production
DATABASE_URL=mysql+pymysql://root:root123456@localhost:3306/book_system
SEED_ON_STARTUP=true
CORS_ORIGINS=*

NEO4J_URI=bolt://localhost:7687
