RECOMMEND_KG_WEIGHT=0.40
RECOMMEND_CF_WEIGHT=0.40
RECOMMEND_HOT_WEIGHT=0.10
RECOMMEND_NEW_WEIGHT=0.10
ITEMCF_CACHE_TTL_SECONDS=21600
