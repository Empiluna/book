          "android.permission.INTERNET",
          "android.permission.ACCESS_NETWORK_STATE",
          "android.permission.ACCESS_WIFI_STATE"
        ]
      },
      "ios": {}
    }
  },
  "mp-weixin": {
    "appid": "",
    "setting": { "urlCheck": false, "es6": true, "postcss": true, "minified": false }
  },
  "h5": {
    "title": "知人知书",
    "devServer": { "port": 8080 }
  }
