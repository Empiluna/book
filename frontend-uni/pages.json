      },
      {
        "pagePath": "pages/shelf/shelf",
        "iconPath": "static/tab-shelf.png",
        "selectedIconPath": "static/tab-shelf-active.png",
        "text": "书架"
      },
      {
        "pagePath": "pages/profile/profile",
        "iconPath": "static/tab-profile.png",
        "selectedIconPath": "static/tab-profile-active.png",
        "text": "我的"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^book-card": "@/components/book-card.vue",
      "^comment-list": "@/components/comment-list.vue"
